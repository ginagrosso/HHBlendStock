# ──────────────────────────────────────────────────────────────────────────────
# Variables de entorno para el módulo de Facturación ARCA
# Copiar este archivo como .env para desarrollo local con el emulator.
# Para deploy en Firebase usar Secret Manager para las claves privadas.
# ──────────────────────────────────────────────────────────────────────────────

# Entorno: "testing" (homologación) o "production"
ARCA_ENVIRONMENT=testing

# CUIT del emisor SIN guiones
# En testing: tu propio CUIT
# En producción: CUIT del cliente
ARCA_CUIT=20XXXXXXXXX9

# Número de Punto de Venta habilitado bajo modalidad "RECE para Aplicativo y Web Services"
ARCA_PUNTO_VENTA=2

# Tipo de comprobante:
#   11 = Factura C (monotributista)  ← usar este
#    6 = Factura B (resp. inscripto → consumidor final)
#    1 = Factura A (resp. inscripto → otro inscripto)
ARCA_CBTE_TIPO=11

# Activar para que cada venta genere automáticamente una Factura C.
# Cambiar a true solo cuando los certificados y el PV estén verificados.
ARCA_HABILITADA=false

# ──────────────────────────────────────────────────────────────────────────────
# Certificados — elegir UNA de las dos opciones:
# ──────────────────────────────────────────────────────────────────────────────

# Opción A (desarrollo local): rutas a los archivos PEM.
# En desarrollo con emulator los paths se resuelven desde functions/lib/arca/ (compilado)
# así que ../../../ apunta a la raíz del proyecto por defecto.
# Sólo descomentar si los archivos están en otra ubicación:
# ARCA_PRIVATE_KEY_PATH=/ruta/absoluta/a/privada.key
# ARCA_CERTIFICATE_PATH=/ruta/absoluta/a/certificado-test.pem

# Opción B (deploy Firebase Functions): contenido del archivo codificado en base64.
# Generar con: base64 -i privada.key | tr -d '\n'
# En producción usar Firebase Secret Manager: firebase functions:secrets:set ARCA_PRIVATE_KEY_B64
# ARCA_PRIVATE_KEY_B64=
# ARCA_CERTIFICATE_B64=
